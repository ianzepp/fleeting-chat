{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fleeting-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Only /mcp* on the apex goes to this Worker; every other path stays on the Railway origin.
  "routes": [{ "pattern": "fleeting.chat/mcp*", "zone_name": "fleeting.chat" }],
  "vars": { "FLEETING_BASE": "https://fleeting.chat", "MAX_CHANNELS_PER_SESSION": "16" },
  "durable_objects": { "bindings": [{ "name": "MCP_OBJECT", "class_name": "FleetingMCP" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FleetingMCP"] }],
  "ratelimits": [{ "name": "IP_LIMITER", "namespace_id": "4201", "simple": { "limit": 60, "period": 60 } }],
  "observability": { "enabled": true }
}
